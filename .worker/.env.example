# ============================================
# advenature-api — Environment Variables Template
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to git!

# ---- D1 Database Binding: advenature-db ----
# Get this from your Cloudflare Dashboard → Workers & Pages → D1
DB=your-d1-database-id-here

# ---- KV Namespace Binding : QUIZ_KV ----
# Get this from your Cloudflare Dashboard → Workers & Pages → KV
QUIZ_KV=your-kv-namespace-id-here

# ---- Telegram Bot Configuration ----
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Your Telegram user ID (get from @userinfobot)
TELEGRAM_ADMIN_CHAT_ID=your-telegram-chat-id-here

# ---- Admin Secret Key (NEW - P0 Security Fix) ----
# Generate a strong random key: openssl rand -base64 32
# This protects admin endpoints from unauthorized access
ADMIN_SECRET_KEY=your-strong-random-secret-key-here
